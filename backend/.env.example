# ============================================================
# BuildFlow Secure AI - Backend Environment Configuration
# ============================================================

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=buildflow-secret-key-change-in-production-min-32-chars

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================
# AI Model Configuration (set at least one)
# ============================================================

# Google Gemini (Primary - Recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI (Fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Primary Model Provider (gemini | openai | anthropic | mock)
PRIMARY_MODEL_PROVIDER=gemini

# Ollama (Local Models - Optional)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Database
# ============================================================

# SQLite (Local Development - Default)
DATABASE_URL=sqlite+aiosqlite:///./buildflow.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/buildflow

# Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# ============================================================
# JWT Configuration
# ============================================================
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10
AGENT_RATE_LIMIT_PER_MINUTE=20
TOKEN_BUDGET_PER_REQUEST=100000
TOKEN_BUDGET_PER_HOUR=500000

# ============================================================
# DDoS Protection
# ============================================================
DDOS_THRESHOLD_PER_SECOND=100
DDOS_BAN_DURATION_SECONDS=3600
DDOS_WHITELIST=["127.0.0.1","::1"]

# ============================================================
# Security
# ============================================================
ENCRYPTION_KEY=encryption-key-exactly-32-chars!!!!
TEE_EXECUTION_TIMEOUT=300
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=120

# ============================================================
# File Uploads
# ============================================================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=["pdf","docx","txt","md","py","js","ts","json","yaml"]

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=text
ENABLE_METRICS=true
ENABLE_TRACING=true
